generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id             String   @id @default(uuid())
  slug           String   @unique
  name           String
  mode           String   @default("fulfillment")
  locale         String   @default("ru")
  currency       String   @default("RUB")
  timezone       String   @default("Europe/Moscow")
  domain         String?
  logoUrl        String?
  brandColor     String   @default("#1F8A70")
  hidePlatform   Boolean  @default(false)
  emailFromName  String?
  blocked        Boolean  @default(false)
  featureFlags   String   @default("{}")
  saasPlan       String   @default("business")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  users          User[]
  legalEntities  LegalEntity[]
  warehouses     Warehouse[]
  departments    Department[]
  clients        Client[]
  products       Product[]
  auditLogs      AuditLog[]
  notifications  Notification[]
  webhooks       Webhook[]
  featureFlagRec FeatureFlag[]
  services       Service[]
  consumables    Consumable[]
  requestTypes   RequestType[]
  requests       Request[]
  tasks          Task[]
  invoices       Invoice[]
  labelTemplates LabelTemplate[]
  printJobs      PrintJob[]
  cisCodes       CisCode[]
  mpAccounts     MarketplaceAccount[]
  apiKeys        ApiKey[]
}

model FeatureFlag {
  id        String  @id @default(uuid())
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id])
  key       String
  enabled   Boolean @default(false)
  @@unique([tenantId, key])
}

model LegalEntity {
  id             String   @id @default(uuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  name           String
  inn            String?
  kpp            String?
  ogrn           String?
  country        String   @default("RU")
  address        String?
  bankName       String?
  bik            String?
  account        String?
  corrAccount    String?
  currency       String   @default("RUB")
  isPrimary      Boolean  @default(false)
  isPartner      Boolean  @default(false)
  stampUrl       String?
  signUrl        String?
  facsimileUrl   String?
  logoUrl        String?
  clients        Client[]
  warehouses     Warehouse[]
  invoices       Invoice[]
  createdAt      DateTime @default(now())
}

model Warehouse {
  id              String   @id @default(uuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  legalEntityId   String?
  legalEntity     LegalEntity? @relation(fields: [legalEntityId], references: [id])
  name            String
  code            String
  address         String?
  addressTemplate String   @default("{zone}-{aisle}-{rack}-{shelf}-{cell}")
  timezone        String   @default("Europe/Moscow")
  zones           Zone[]
  cells           Cell[]
  createdAt       DateTime @default(now())
  @@unique([tenantId, code])
}

model Zone {
  id          String     @id @default(uuid())
  tenantId    String
  warehouseId String
  warehouse   Warehouse  @relation(fields: [warehouseId], references: [id])
  name        String
  code        String
  type        String     @default("storage")
  cells       Cell[]
}

model Cell {
  id            String    @id @default(uuid())
  tenantId      String
  warehouseId   String
  warehouse     Warehouse @relation(fields: [warehouseId], references: [id])
  zoneId        String?
  zone          Zone?     @relation(fields: [zoneId], references: [id])
  code          String
  aisle         String?
  rack          String?
  shelf         String?
  type          String    @default("storage")
  volumeCm3     Int       @default(0)
  maxWeightG    Int       @default(0)
  mixClients    Boolean   @default(false)
  mixLots       Boolean   @default(false)
  blocked       Boolean   @default(false)
  balances      StockBalance[]
  containers    Container[]
  @@unique([tenantId, warehouseId, code])
}

model Department {
  id        String @id @default(uuid())
  tenantId  String
  tenant    Tenant @relation(fields: [tenantId], references: [id])
  name      String
  users     User[]
}

model User {
  id              String   @id @default(uuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  email           String
  passwordHash    String
  fullName        String
  role            String
  permissionsJson String   @default("{}")
  totpSecret      String?
  totpEnabled     Boolean  @default(false)
  telegramChatId  String?
  clientId        String?
  client          Client?  @relation(fields: [clientId], references: [id])
  departmentId    String?
  department      Department? @relation(fields: [departmentId], references: [id])
  warehouseIds    String   @default("[]")
  pinHash         String?
  active          Boolean  @default(true)
  birthday        DateTime?
  pieceRatesJson  String   @default("{}")
  createdAt       DateTime @default(now())
  shifts          Shift[]
  tasks           Task[]
  auditLogs       AuditLog[]
  pieceworks      Piecework[]
  @@unique([tenantId, email])
}

model Shift {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  startedAt DateTime @default(now())
  endedAt   DateTime?
  method    String   @default("qr")
}

model Piecework {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  kind      String
  qty       Int
  rateKop   Int
  amountKop Int
  requestId String?
  createdAt DateTime @default(now())
}

model Client {
  id                String   @id @default(uuid())
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id])
  legalEntityId     String?
  legalEntity       LegalEntity? @relation(fields: [legalEntityId], references: [id])
  holdingId         String?
  name              String
  inn               String?
  telegramChatId    String?
  email             String?
  fbsEnabled        Boolean  @default(true)
  fboEnabled        Boolean  @default(true)
  freeStorageDays   Int      @default(0)
  storageRateKop    Int      @default(150)
  storageUnit       String   @default("volume_day")
  seeCells          Boolean  @default(true)
  canCreateBundles  Boolean  @default(true)
  canEditRequests   Boolean  @default(true)
  priceMarkupPct    Float    @default(0)
  users             User[]
  products          Product[]
  requests          Request[]
  invoices          Invoice[]
  mpAccounts        MarketplaceAccount[]
  balances          StockBalance[]
  createdAt         DateTime @default(now())
}

model Product {
  id              String   @id @default(uuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  clientId        String
  client          Client   @relation(fields: [clientId], references: [id])
  name            String
  sku             String
  articleMp       String?
  photoUrl        String?
  widthMm         Int      @default(0)
  heightMm        Int      @default(0)
  lengthMm        Int      @default(0)
  weightG         Int      @default(0)
  volumeCm3       Int      @default(0)
  requiresCis     Boolean  @default(false)
  insertsJson     String   @default("[]")
  packingReq      String?
  reorderPoint    Int      @default(0)
  tags            String   @default("")
  customJson      String   @default("{}")
  archived        Boolean  @default(false)
  modificationOf  String?
  barcodes        Barcode[]
  bundleItems     BundleItem[] @relation("Bundle")
  componentOf     BundleItem[] @relation("Component")
  balances        StockBalance[]
  lots            Lot[]
  cisCodes        CisCode[]
  createdAt       DateTime @default(now())
  @@unique([tenantId, clientId, sku])
}

model Barcode {
  id        String  @id @default(uuid())
  tenantId  String
  productId String
  product   Product @relation(fields: [productId], references: [id])
  code      String
  kind      String  @default("ean13")
  @@unique([tenantId, code])
}

model BundleItem {
  id            String  @id @default(uuid())
  tenantId      String
  bundleId      String
  bundle        Product @relation("Bundle", fields: [bundleId], references: [id])
  componentId   String
  component     Product @relation("Component", fields: [componentId], references: [id])
  qty           Int     @default(1)
}

model Lot {
  id          String   @id @default(uuid())
  tenantId    String
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  number      String
  producedAt  DateTime?
  expiresAt   DateTime?
  gtd         String?
}

model Serial {
  id         String  @id @default(uuid())
  tenantId   String
  productId  String
  lotId      String?
  code       String
  status     String  @default("in_stock")
  @@unique([tenantId, code])
}

model Container {
  id          String  @id @default(uuid())
  tenantId    String
  kind        String
  barcode     String
  cellId      String?
  cell        Cell?   @relation(fields: [cellId], references: [id])
  clientId    String?
  parentId    String?
  capacity    Int     @default(0)
  status      String  @default("open")
  @@unique([tenantId, barcode])
}

model StockBalance {
  id          String  @id @default(uuid())
  tenantId    String
  warehouseId String
  cellId      String
  cell        Cell    @relation(fields: [cellId], references: [id])
  productId   String
  product     Product @relation(fields: [productId], references: [id])
  clientId    String
  client      Client  @relation(fields: [clientId], references: [id])
  lotId       String  @default("")
  containerId String  @default("")
  stockType   String
  qty         Int     @default(0)
  @@unique([tenantId, warehouseId, cellId, productId, lotId, containerId, stockType, clientId])
  @@index([tenantId, productId, stockType])
  @@index([tenantId, warehouseId, stockType])
}

model StockMove {
  id           String   @id @default(uuid())
  tenantId     String
  type         String
  productId    String
  clientId     String
  qty          Int
  fromCellId   String?
  toCellId     String?
  fromType     String?
  toType       String?
  lotId        String?
  containerId  String?
  requestId    String?
  document     String?
  userId       String?
  device       String?
  barcode      String?
  cis          String?
  warehouseId  String?
  createdAt    DateTime @default(now())
  @@index([tenantId, createdAt])
  @@index([tenantId, productId])
}

model RequestType {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  code          String
  name          String
  builtIn       Boolean  @default(false)
  version       Int      @default(1)
  stagesJson    String
  formSchema    String   @default("{}")
  requests      Request[]
  @@unique([tenantId, code, version])
}

model Request {
  id              String   @id @default(uuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  number          String
  typeId          String
  type            RequestType @relation(fields: [typeId], references: [id])
  clientId        String?
  client          Client?  @relation(fields: [clientId], references: [id])
  warehouseId     String?
  status          String   @default("draft")
  currentStageKey String?
  slaDueAt        DateTime?
  assigneeId      String?
  createdById     String?
  source          String   @default("staff")
  warningJson     String   @default("[]")
  payloadJson     String   @default("{}")
  gtd             String?
  marketplace     String?
  mpShipmentId    String?
  locked          Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  lines           RequestLine[]
  expenses        RequestExpense[]
  stages          RequestStage[]
  facts           ServiceFact[]
  tasks           Task[]
  @@unique([tenantId, number])
  @@index([tenantId, status])
}

model RequestLine {
  id         String  @id @default(uuid())
  tenantId   String
  requestId  String
  request    Request @relation(fields: [requestId], references: [id])
  productId  String
  sku        String
  name       String
  plannedQty Int
  factQty    Int     @default(0)
  defectQty  Int     @default(0)
}

model RequestExpense {
  id        String @id @default(uuid())
  tenantId  String
  requestId String
  request   Request @relation(fields: [requestId], references: [id])
  kind      String
  amountKop Int
  comment   String?
}

model RequestStage {
  id          String    @id @default(uuid())
  tenantId    String
  requestId   String
  request     Request   @relation(fields: [requestId], references: [id])
  key         String
  title       String
  status      String    @default("pending")
  assigneeId  String?
  startedAt   DateTime?
  closedAt    DateTime?
  closedById  String?
  slaMinutes  Int       @default(0)
}

model Task {
  id          String    @id @default(uuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  requestId   String?
  request     Request?  @relation(fields: [requestId], references: [id])
  userId      String?
  user        User?     @relation(fields: [userId], references: [id])
  warehouseId String?
  title       String
  kind        String    @default("request")
  dueAt       DateTime?
  status      String    @default("open")
  createdAt   DateTime  @default(now())
}

model MarketplaceAccount {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id])
  marketplace   String
  name          String
  apiKeyEnc     String   @default("")
  clientIdExt   String?
  warehouseExt  String?
  active        Boolean  @default(true)
  lastSyncAt    DateTime?
  lastError     String?
  orders        MarketplaceOrder[]
  shipments     MarketplaceShipment[]
}

model MarketplaceOrder {
  id            String   @id @default(uuid())
  tenantId      String
  accountId     String
  account       MarketplaceAccount @relation(fields: [accountId], references: [id])
  externalId    String
  postingNumber String?
  status        String
  payloadJson   String   @default("{}")
  reserved      Boolean  @default(false)
  labelUrl      String?
  tracking      String?
  pvz           String?
  warehouseId   String?
  legalEntityId String?
  requestId     String?
  createdAt     DateTime @default(now())
  @@unique([tenantId, accountId, externalId])
}

model MarketplaceShipment {
  id          String   @id @default(uuid())
  tenantId    String
  accountId   String
  account     MarketplaceAccount @relation(fields: [accountId], references: [id])
  requestId   String?
  externalId  String?
  qr          String?
  status      String   @default("created")
  type        String   @default("fbo")
  discrepancy String?
  createdAt   DateTime @default(now())
}

model CisCode {
  id          String    @id @default(uuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  productId   String?
  product     Product?  @relation(fields: [productId], references: [id])
  clientId    String?
  code        String
  status      String    @default("uploaded")
  printCopies Int       @default(0)
  uploadedAt  DateTime  @default(now())
  printedAt   DateTime?
  labeledAt   DateTime?
  warehouseId String?
  requestId   String?
  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([tenantId, warehouseId])
}

model LabelTemplate {
  id         String @id @default(uuid())
  tenantId   String
  tenant     Tenant @relation(fields: [tenantId], references: [id])
  name       String
  widthMm    Int
  heightMm   Int
  layoutJson String
  kind       String @default("product")
}

model PrintJob {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  printer    String?
  zpl        String?
  pdfPath    String?
  status     String   @default("queued")
  copies     Int      @default(1)
  createdAt  DateTime @default(now())
}

model Service {
  id          String @id @default(uuid())
  tenantId    String
  tenant      Tenant @relation(fields: [tenantId], references: [id])
  code        String
  name        String
  unit        String @default("pcs")
  priceKop    Int
  costKop     Int    @default(0)
  sizeClass   String?
}

model Consumable {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  name     String
  sku      String
  qty      Int    @default(0)
  costKop  Int    @default(0)
}

model ServiceFact {
  id          String   @id @default(uuid())
  tenantId    String
  requestId   String?
  request     Request? @relation(fields: [requestId], references: [id])
  clientId    String
  serviceCode String
  qty         Float
  priceKop    Int
  amountKop   Int
  stageKey    String?
  createdAt   DateTime @default(now())
}

model StorageTariff {
  id         String @id @default(uuid())
  tenantId   String
  clientId   String
  unit       String @default("volume_day")
  rateKop    Int
  freeDays   Int    @default(0)
  defectRule String @default("same")
}

model StorageDaily {
  id        String   @id @default(uuid())
  tenantId  String
  clientId  String
  date      String
  volumeCm3 Int
  pallets   Int      @default(0)
  amountKop Int
  @@unique([tenantId, clientId, date])
}

model Invoice {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id])
  legalEntityId String?
  legalEntity   LegalEntity? @relation(fields: [legalEntityId], references: [id])
  number        String
  kind          String
  status        String   @default("draft")
  periodFrom    String?
  periodTo      String?
  requestId     String?
  amountKop     Int
  currency      String   @default("RUB")
  linesJson     String   @default("[]")
  pdfPath       String?
  createdAt     DateTime @default(now())
  payments      Payment[]
  @@unique([tenantId, number])
}

model Payment {
  id         String   @id @default(uuid())
  tenantId   String
  invoiceId  String?
  invoice    Invoice? @relation(fields: [invoiceId], references: [id])
  clientId   String
  amountKop  Int
  method     String   @default("manual")
  comment    String?
  createdAt  DateTime @default(now())
}

model DocumentFile {
  id        String   @id @default(uuid())
  tenantId  String
  kind      String
  name      String
  path      String
  clientId  String?
  requestId String?
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  channel   String
  event     String
  title     String
  body      String
  userId    String?
  clientId  String?
  sentAt    DateTime @default(now())
  payload   String   @default("{}")
}

model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  before    String?
  after     String?
  createdAt DateTime @default(now())
}

model Webhook {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  idempotency String
  source      String
  path        String
  payload     String
  status      String   @default("processed")
  createdAt   DateTime @default(now())
  @@unique([tenantId, idempotency])
}

model ApiKey {
  id         String    @id @default(uuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  name       String
  keyHash    String
  prefix     String
  scopes     String    @default("[]")
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
}

model IdempotencyRecord {
  id        String   @id @default(uuid())
  tenantId  String
  key       String
  response  String
  createdAt DateTime @default(now())
  @@unique([tenantId, key])
}

model PickWave {
  id          String   @id @default(uuid())
  tenantId    String
  warehouseId String
  number      String
  status      String   @default("open")
  orderIds    String   @default("[]")
  linesJson   String   @default("[]")
  assigneeId  String?
  createdAt   DateTime @default(now())
}
